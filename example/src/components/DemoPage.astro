---
// A page of the project's own, from the package's pieces: the demo app.
import { Page, Hero, Split } from 'nsgo-website/components';
import type { Lang } from 'nsgo-website/config';

interface Props {
	lang: string;
}
const lang = Astro.props.lang as Lang;
const words = {
	en: {
		title: 'Demo',
		description: 'The demo app: the complete notes app.',
		headline: ['The demo app,', 'every note in one place.'] as [string, string],
		lead: 'examples/demo is the whole of Sample Notes, built on NSGo.',
		run: 'Run it',
		runText: 'From the repository, with hot reload.',
		source: 'Source',
	},
	zh: {
		title: '演示',
		description: '演示应用：完整的笔记应用。',
		headline: ['演示应用，', '所有笔记都在一处。'] as [string, string],
		lead: 'examples/demo 就是基于 NSGo 的完整示例笔记应用。',
		run: '运行',
		runText: '在仓库里运行，支持热重载。',
		source: '源码',
	},
};
const t = words[lang as keyof typeof words] ?? words.en;
---

<Page lang={lang} title={t.title} description={t.description}>
	<div class="home">
		<Hero
			lang={lang}
			headline={t.headline}
			lead={t.lead}
			actions={[{ label: t.source, href: 'https://github.com/nsgo-dev/nsgo-website/blob/main/example/src/components/DemoPage.astro', icon: 'github' }]}
		/>
		<Split title={t.run} text={t.runText} code={{ lang: 'sh', code: 'go tool nsgo dev examples/demo' }} />
	</div>
</Page>
