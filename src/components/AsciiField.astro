---
// A faint field of characters behind its parent: a WebGL2 shader draws a
// grid of ASCII glyphs whose density follows slowly flowing noise, clears
// around the middle where the parent's text sits and brightens near the
// pointer. It draws only while on screen, holds still for readers who ask
// for less motion, and leaves nothing behind where WebGL2 is missing.
---

<ascii-field class="ascii-field" aria-hidden="true"><canvas></canvas></ascii-field>

<script>
	const vertex = `#version 300 es
in vec2 p;
void main() { gl_Position = vec4(p, 0.0, 1.0); }`;

	const fragment = `#version 300 es
precision highp float;
uniform vec2 res;
uniform float time;
uniform float cell;
uniform vec2 pointer;
uniform vec3 color;
out vec4 outColor;

vec2 hash(vec2 p) {
	p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
	return -1.0 + 2.0 * fract(sin(p) * 43758.5453123);
}
float noise(vec2 p) {
	vec2 i = floor(p), f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(mix(dot(hash(i), f), dot(hash(i + vec2(1, 0)), f - vec2(1, 0)), u.x),
		mix(dot(hash(i + vec2(0, 1)), f - vec2(0, 1)), dot(hash(i + vec2(1, 1)), f - vec2(1, 1)), u.x), u.y);
}
float fbm(vec2 p) {
	float v = 0.0, a = 0.5;
	for (int i = 0; i < 4; i++) { v += a * noise(p); p *= 2.03; a *= 0.5; }
	return v;
}
// A 5x5 glyph, one bit a pixel, at p in [-1, 1].
float glyph(int n, vec2 p) {
	p = floor(p * vec2(4.0, -4.0) + 2.5);
	if (clamp(p.x, 0.0, 4.0) != p.x || clamp(p.y, 0.0, 4.0) != p.y) return 0.0;
	int a = int(p.x + 5.0 * p.y);
	return float((n >> a) & 1);
}

void main() {
	vec2 at = floor(gl_FragCoord.xy / cell);
	vec2 center = (at + 0.5) * cell;
	vec2 uv = center / res.y;
	float t = time * 0.05;

	vec2 warp = vec2(fbm(uv * 1.4 + vec2(t, -t)), fbm(uv * 1.4 + vec2(-t, t) + 5.2));
	float v = fbm(uv * 2.0 + warp * 1.8 + vec2(t * 2.0, 0.0)) * 0.5 + 0.5;
	// A slow scan line sweeping across, for a little life.
	float scan = exp(-pow((fract(uv.x * 0.25 - time * 0.03) - 0.5) * 9.0, 2.0));
	v += scan * 0.12;
	float d = distance(center, pointer) / res.y;
	v += 0.3 * exp(-d * d * 18.0);

	// Clear around the middle, where the text is.
	vec2 c = center / res - 0.5;
	float mask = smoothstep(0.8, 1.35, length(c / vec2(0.32, 0.4)));
	float g = smoothstep(0.42, 0.78, v) * mask;

	int n = 0;
	if (g > 0.08) n = 4096;      // .
	if (g > 0.22) n = 65600;     // :
	if (g > 0.36) n = 332772;    // +
	if (g > 0.5) n = 15255086;   // o
	if (g > 0.64) n = 11512810;  // #
	if (g > 0.78) n = 13195790;  // @
	float on = glyph(n, (mod(gl_FragCoord.xy, cell) / cell - 0.5) * 2.0);
	float a = on * (0.35 + 0.65 * g);
	outColor = vec4(color * a, a);
}`;

	class AsciiField extends HTMLElement {
		connectedCallback() {
			const canvas = this.querySelector('canvas')!;
			const gl = canvas.getContext('webgl2', { premultipliedAlpha: true, antialias: false });
			if (!gl) return;
			const shader = (type: number, source: string) => {
				const s = gl.createShader(type)!;
				gl.shaderSource(s, source);
				gl.compileShader(s);
				return s;
			};
			const program = gl.createProgram()!;
			gl.attachShader(program, shader(gl.VERTEX_SHADER, vertex));
			gl.attachShader(program, shader(gl.FRAGMENT_SHADER, fragment));
			gl.linkProgram(program);
			if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return;
			gl.useProgram(program);
			gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
			gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
			const p = gl.getAttribLocation(program, 'p');
			gl.enableVertexAttribArray(p);
			gl.vertexAttribPointer(p, 2, gl.FLOAT, false, 0, 0);
			const u = (name: string) => gl.getUniformLocation(program, name);
			const [res, time, cell, pointer, color] = ['res', 'time', 'cell', 'pointer', 'color'].map(u);

			// The site's accent, read again when the theme changes.
			const readColor = () => {
				const probe = document.createElement('span');
				probe.style.color = getComputedStyle(this).getPropertyValue('--accent');
				this.append(probe);
				const [r, g, b] = getComputedStyle(probe).color.match(/[\d.]+/g)!.map(Number);
				probe.remove();
				gl.uniform3f(color, r / 255, g / 255, b / 255);
			};
			readColor();
			new MutationObserver(() => {
				readColor();
				if (still) draw(0);
			}).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

			const dpr = () => Math.min(devicePixelRatio, 2);
			const resize = () => {
				const r = dpr();
				canvas.width = Math.round(this.clientWidth * r);
				canvas.height = Math.round(this.clientHeight * r);
				gl.viewport(0, 0, canvas.width, canvas.height);
				gl.uniform2f(res, canvas.width, canvas.height);
				gl.uniform1f(cell, Math.round(11 * r));
			};
			resize();

			// The pointer, eased toward where it is, in the canvas's pixels.
			const far = -1e5;
			let want = { x: far, y: far };
			let have = { ...want };
			const host = this.parentElement ?? this;
			host.addEventListener('pointermove', (e) => {
				const rect = canvas.getBoundingClientRect();
				want = { x: (e.clientX - rect.left) * dpr(), y: (rect.bottom - e.clientY) * dpr() };
				if (have.x === far) have = { ...want };
			});
			host.addEventListener('pointerleave', () => (want = { x: far, y: far }));

			const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
			const draw = (ms: number) => {
				have.x += (want.x - have.x) * 0.08;
				have.y += (want.y - have.y) * 0.08;
				gl.uniform1f(time, ms / 1000);
				gl.uniform2f(pointer, have.x, have.y);
				gl.drawArrays(gl.TRIANGLES, 0, 3);
			};
			let frame = 0;
			const loop = (ms: number) => {
				draw(ms);
				frame = requestAnimationFrame(loop);
			};
			new ResizeObserver(() => {
				resize();
				if (still) draw(0);
			}).observe(this);
			if (still) {
				draw(0);
				return;
			}
			new IntersectionObserver(([entry]) => {
				cancelAnimationFrame(frame);
				if (entry.isIntersecting) frame = requestAnimationFrame(loop);
			}).observe(this);
		}
	}
	customElements.define('ascii-field', AsciiField);
</script>

<style>
	.ascii-field {
		position: absolute;
		inset: 0;
		z-index: 0;
		display: block;
		opacity: 0.26;
		pointer-events: none;
	}
	:global([data-theme='light']) .ascii-field {
		opacity: 0.18;
	}
	canvas {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
