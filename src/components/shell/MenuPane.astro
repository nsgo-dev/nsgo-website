---
// The menu: on phones, a popover with the site's links, the language and
// theme choices the header has no room for and, in the docs, the sidebar;
// on wider screens the docs show it beside the content.
import { Icon } from '@astrojs/starlight/components';
import { Image } from 'astro:assets';
import { images } from 'virtual:nsgo-website/assets';
import { langOf, langs, site } from '../../site';
import ChoiceGroup from './ChoiceGroup.astro';
import { languageChoices, themeChoices } from './choices';
import type { ResolvedLink } from '../../resolve';

interface Props {
	/** Whether wide screens show the pane in place, as the docs' sidebar. */
	docked: boolean;
}
const { docked } = Astro.props;
const lang = langOf(Astro.locals.starlightRoute.lang);
const s = site[lang];
const t = s.t;
// The header's own links, then GitHub, then each of its menus as a group.
const links: ResolvedLink[] = [...s.nav.flatMap((n) => (n.links ? [] : [n])), { label: 'GitHub', href: s.repo, external: true }];
const groups = [...(s.accounts.length ? [{ label: 'X', links: s.accounts }] : []), ...s.nav.flatMap((n) => (n.links ? [n] : []))];
const ext = (link: ResolvedLink) => (link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {});
---

<sl-sidebar-pane popover="auto" id="starlight__sidebar" class="menu-pane" data-docked={docked ? '' : undefined}>
	<div class="menu-content">
		<nav class="menu-links" aria-label={t.nav.label}>
			{
				links.map((link) => (
					<a href={link.href} {...ext(link)}>
						{link.label}
						{link.external && <Icon name="external" size="0.8rem" class="external" />}
					</a>
				))
			}
			{
				groups.map((group) => (
					<>
						<p class="menu-group">{group.label}</p>
						{group.links.map((link) => (
							<a href={link.href} {...ext(link)}>
								{link.avatar && <Image class="menu-avatar" src={images[link.avatar]} alt="" width={20} height={20} densities={[1, 2]} />}
								{link.label}
								{link.note && group.label === 'X' && <span class="menu-note">{link.note}</span>}
								{link.external && <Icon name="external" size="0.8rem" class="external" />}
							</a>
						))}
					</>
				))
			}
		</nav>
		<div class="menu-choices">
			{langs.length > 1 && <ChoiceGroup name="language" label={t.language.name} items={languageChoices(lang)} />}
			<ChoiceGroup name="theme" label={t.theme.name} items={themeChoices(lang)} />
		</div>
		{
			docked && (
				<nav class="sidebar-content" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
					<slot name="sidebar" />
				</nav>
			)
		}
	</div>
</sl-sidebar-pane>

<script>
	class SidebarPane extends HTMLElement {
		connectedCallback() {
			const wide = matchMedia('(min-width: 50rem)');
			const update = () => {
				this.popover = wide.matches && this.hasAttribute('data-docked') ? null : 'auto';
			};
			update();
			wide.addEventListener('change', update);
			// Keep the keyboard in the menu while it is open.
			this.addEventListener('toggle', (e) => {
				const open = (e as ToggleEvent).newState === 'open';
				document.querySelectorAll<HTMLElement>('.main-frame, .site-footer').forEach((el) => el.toggleAttribute('inert', open));
			});
		}
	}
	customElements.define('sl-sidebar-pane', SidebarPane);
</script>
