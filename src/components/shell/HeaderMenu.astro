---
// A soft icon button in the header that opens a small menu of choices, as
// for the theme and the language. The page's script marks the chosen one
// and acts on the reader's choice.
import { Icon } from '@astrojs/starlight/components';

export interface Item {
	label: string;
	value: string;
}

interface Props {
	/** The menu's accessible name. */
	label: string;
	items: Item[];
	/** Set on the menu, for the script that acts on its choices. */
	name: string;
	class?: string;
}
const { label, items, name, class: className } = Astro.props;
---

<header-menu class:list={['header-menu', className]} data-name={name}>
	<button type="button" class="menu-trigger" aria-haspopup="menu" aria-expanded="false" aria-label={label} title={label} data-kubai-trigger>
		<slot name="icon" />
	</button>
	<div class="menu-list" role="menu" aria-label={label} hidden>
		{
			items.map((item) => (
				<button type="button" role="menuitemradio" aria-checked="false" data-value={item.value} tabindex="-1" data-kubai-trigger>
					<slot name={`icon-${item.value}`} />
					<span>{item.label}</span>
					<Icon name="approve-check" size="0.95rem" class="check" />
				</button>
			))
		}
	</div>
</header-menu>

<script>
	class HeaderMenu extends HTMLElement {
		connectedCallback() {
			const trigger = this.querySelector<HTMLButtonElement>('.menu-trigger')!;
			const list = this.querySelector<HTMLElement>('.menu-list')!;
			const items = () => [...list.querySelectorAll<HTMLElement>('[role^="menuitem"]')];

			const open = (focus?: 'first' | 'selected') => {
				for (const other of document.querySelectorAll<HTMLElement>('header-menu')) {
					if (other !== this) (other as HeaderMenu).close?.();
				}
				list.hidden = false;
				trigger.setAttribute('aria-expanded', 'true');
				const all = items();
				const target = (focus === 'selected' && all.find((i) => i.getAttribute('aria-checked') === 'true')) || all[0];
				if (focus) target?.focus();
			};
			this.close = (refocus = false) => {
				if (list.hidden) return;
				list.hidden = true;
				trigger.setAttribute('aria-expanded', 'false');
				if (refocus) trigger.focus();
			};

			trigger.addEventListener('click', () => (list.hidden ? open() : this.close?.()));
			trigger.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					open('selected');
				}
			});
			list.addEventListener('keydown', (e) => {
				const all = items();
				const i = all.indexOf(document.activeElement as HTMLElement);
				if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
					e.preventDefault();
					all[(i + (e.key === 'ArrowDown' ? 1 : -1) + all.length) % all.length].focus();
				} else if (e.key === 'Home' || e.key === 'End') {
					e.preventDefault();
					all[e.key === 'Home' ? 0 : all.length - 1].focus();
				} else if (e.key === 'Escape') {
					this.close?.(true);
				} else if (e.key === 'Tab') {
					this.close?.();
				}
			});
			list.addEventListener('click', (e) => {
				const item = (e.target as HTMLElement).closest<HTMLElement>('[data-value]');
				if (!item) return;
				this.dispatchEvent(new CustomEvent('choose', { detail: item.dataset.value }));
				this.close?.(true);
			});
			document.addEventListener('pointerdown', (e) => {
				if (!this.contains(e.target as Node)) this.close?.();
			});
		}
		close?: (refocus?: boolean) => void;

		/** Marks the item of `value` as chosen. */
		select(value: string) {
			for (const item of this.querySelectorAll<HTMLElement>('[data-value]')) {
				item.setAttribute('aria-checked', String(item.dataset.value === value));
			}
			this.dataset.selected = value;
		}
	}
	customElements.define('header-menu', HeaderMenu);
</script>

<style>
	.header-menu {
		position: relative;
		display: block;
	}
	.menu-trigger {
		display: inline-grid;
		place-items: center;
		width: 2.125rem;
		height: 2.125rem;
		padding: 0;
		border: 0;
		border-radius: 0.625rem;
		background-color: var(--surface);
		color: var(--text);
		cursor: pointer;
		transition: background-color 0.2s;
	}
	.menu-trigger:hover,
	.menu-trigger[aria-expanded='true'] {
		background-color: var(--surface-2);
	}
	.menu-trigger:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 1px;
	}

	.menu-list {
		position: absolute;
		top: calc(100% + 0.375rem);
		right: 0;
		z-index: 60;
		display: grid;
		min-width: 9rem;
		padding: 0.25rem;
		border: 1px solid var(--border);
		border-radius: 0.75rem;
		background-color: var(--bg);
		box-shadow:
			0 1px 2px rgb(0 0 0 / 0.06),
			0 12px 32px -8px rgb(0 0 0 / 0.2);
		transform-origin: top right;
		animation: menu-in 0.18s var(--ease);
	}
	.menu-list[hidden] {
		display: none;
	}
	@keyframes menu-in {
		from {
			opacity: 0;
			transform: scale(0.96) translateY(-4px);
		}
	}
	.menu-list > * {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		width: 100%;
		padding: 0.3125rem 0.5rem;
		border: 0;
		border-radius: 0.5rem;
		background: none;
		color: var(--text);
		font: inherit;
		font-size: 0.8125rem;
		line-height: 1.25rem;
		text-align: start;
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		outline: none;
	}
	.menu-list > :is(:hover, :focus-visible) {
		background-color: var(--surface-2);
	}
	.menu-list > * > span {
		flex: 1;
	}
	.menu-list .check {
		color: var(--text);
		opacity: 0;
	}
	.menu-list [aria-checked='true'] .check {
		opacity: 1;
	}
	@media (prefers-reduced-motion: reduce) {
		.menu-list {
			animation: none;
		}
	}
</style>
