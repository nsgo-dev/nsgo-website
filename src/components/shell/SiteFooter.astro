---
// The footer every page shares, home and docs alike: one line, the
// copyright with the code's license on the left, the key links on the
// right and, in the corner, the sponsors page.
import { Icon } from '@astrojs/starlight/components';
import { langOf, site } from '../../site';
import KIcon from '../KIcon.astro';

const f = site[langOf(Astro.locals.starlightRoute.lang)].footer;
---

<footer class="site-footer">
	<div class="container footer-row">
		<p class="footer-copyright">
			{f.copyright}
			{
				f.license && (
					<a href={f.license.href} target="_blank" rel="noopener noreferrer">
						{f.license.label}
					</a>
				)
			}
		</p>
		<ul class="footer-links">
			{
				f.links.map((link) => (
					<li>
						<a href={link.href} {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
							{link.label}
							{link.external && <Icon name="external" size="0.7rem" class="external" />}
						</a>
					</li>
				))
			}
			{
				f.sponsors && (
					<li>
						<a class="footer-sponsors" href={f.sponsors.href} data-kubai-trigger>
							<KIcon name="heart" size={14} color="#ec4899" />
							{f.sponsors.label}
						</a>
					</li>
				)
			}
		</ul>
	</div>
</footer>
