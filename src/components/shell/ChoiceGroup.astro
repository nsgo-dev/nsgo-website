---
// A labeled row of choices in the phone menu, standing for one of the
// header's icon menus there. It speaks as the header's menus do: the page's
// script marks the chosen one with select() and hears a `choose` event.
import KIcon from '../KIcon.astro';
import type { Choice } from './choices';

interface Props {
	/** Set on the group, for the script that acts on its choices. */
	name: string;
	label: string;
	items: Choice[];
}
const { name, label, items } = Astro.props;
const id = `choices-${name}`;
---

<choice-group class="choice-group" data-name={name}>
	<p class="choice-label" id={id}>{label}</p>
	<div class="choice-items" role="radiogroup" aria-labelledby={id}>
		{
			items.map((item) => (
				<button type="button" role="radio" aria-checked="false" data-value={item.value} data-kubai-trigger>
					{item.icon ? (
						<KIcon name={item.icon} size={16} color={item.color} />
					) : (
						<span class="lang-tag" style={`--tag: ${item.color}`}>
							{item.mark}
						</span>
					)}
					<span>{item.label}</span>
				</button>
			))
		}
	</div>
</choice-group>

<script>
	class ChoiceGroup extends HTMLElement {
		connectedCallback() {
			// Head.astro puts the reader's choices on the root before the page
			// shows, in case this is defined after the page's script ran.
			this.select(document.documentElement.dataset[`${this.dataset.name}Choice`] || 'auto');
			this.addEventListener('click', (e) => {
				const item = (e.target as HTMLElement).closest<HTMLElement>('[data-value]');
				if (item) this.dispatchEvent(new CustomEvent('choose', { detail: item.dataset.value }));
			});
		}

		/** Marks the item of `value` as chosen. */
		select(value: string) {
			for (const item of this.querySelectorAll<HTMLElement>('[data-value]')) {
				item.setAttribute('aria-checked', String(item.dataset.value === value));
			}
		}
	}
	customElements.define('choice-group', ChoiceGroup);
</script>

<style>
	.choice-group {
		display: grid;
		gap: 0.5rem;
	}
	.choice-label {
		margin: 0;
		padding: 0 0.625rem;
		color: var(--faint);
		font-size: 0.75rem;
		font-weight: 650;
	}
	.choice-items {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(6rem, 1fr));
		gap: 0.25rem;
		padding: 0.25rem;
		border-radius: 0.75rem;
		background-color: var(--surface);
	}
	.choice-items button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.375rem;
		min-width: 0;
		height: 2.25rem;
		padding: 0 0.5rem;
		border: 0;
		border-radius: 0.5rem;
		background: none;
		color: var(--muted);
		font: inherit;
		font-size: 0.875rem;
		font-weight: 500;
		white-space: nowrap;
		cursor: pointer;
		transition:
			color 0.15s,
			background-color 0.15s,
			box-shadow 0.15s;
	}
	.choice-items button > span:last-child {
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.choice-items button:hover {
		color: var(--text);
	}
	.choice-items button[aria-checked='true'] {
		background-color: var(--bg);
		color: var(--text);
		box-shadow:
			0 1px 2px rgb(0 0 0 / 0.08),
			0 0 0 1px var(--border);
	}
	.choice-items button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 1px;
	}
</style>
