---
// A link of the header's navigation that opens a menu of further links, as
// for the community's places, or an icon button of the header's actions that
// does the same, as for the X accounts.
import { Icon } from '@astrojs/starlight/components';
import type { StarlightIcon } from '@astrojs/starlight/types';
import { Image } from 'astro:assets';
import { images } from 'virtual:nsgo-website/assets';
import nsgoLogo from '../../assets/nsgo.svg?url';
import type { ResolvedLink } from '../../resolve';

interface Props {
	label: string;
	links: ResolvedLink[];
	/** Shows only this icon, with the label as its name, and opens the menu toward the start. */
	icon?: StarlightIcon;
	class?: string;
}
const { label, links, icon, class: className } = Astro.props;
---

<nav-menu class:list={['nav-menu', className]} data-icon={icon ? '' : undefined}>
	{
		icon ? (
			<button type="button" class="nav-trigger icon-trigger" aria-haspopup="true" aria-expanded="false" aria-label={label} title={label}>
				<Icon name={icon} size="1rem" />
			</button>
		) : (
			<button type="button" class="nav-trigger" aria-haspopup="true" aria-expanded="false">
				{label}
				<Icon name="down-caret" size="1rem" class="caret" />
			</button>
		)
	}
	<ul class="nav-list" hidden>
		{
			links.map((link) => (
				<li>
					<a href={link.href} {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
						{(link.avatar || link.icon) && (
							<span class:list={['nav-icon', link.avatar && 'avatar']}>
								{link.avatar ? (
									<Image src={images[link.avatar]} alt="" width={28} height={28} densities={[1, 2]} />
								) : link.icon === 'nsgo' ? (
									<img src={nsgoLogo} alt="" width="18" height="18" />
								) : (
									<Icon name={link.icon!} size="1.05rem" />
								)}
							</span>
						)}
						<span class="nav-text">
							<span>{link.label}</span>
							{link.note && <span class="nav-note">{link.note}</span>}
						</span>
						{link.external && <Icon name="external" size="0.8rem" class="external" />}
					</a>
				</li>
			))
		}
	</ul>
</nav-menu>

<script>
	class NavMenu extends HTMLElement {
		connectedCallback() {
			const trigger = this.querySelector<HTMLButtonElement>('.nav-trigger')!;
			const list = this.querySelector<HTMLElement>('.nav-list')!;
			const links = () => [...list.querySelectorAll<HTMLAnchorElement>('a')];
			const open = (focus = false) => {
				list.hidden = false;
				trigger.setAttribute('aria-expanded', 'true');
				if (focus) links()[0]?.focus();
			};
			const close = (refocus = false) => {
				if (list.hidden) return;
				list.hidden = true;
				trigger.setAttribute('aria-expanded', 'false');
				if (refocus) trigger.focus();
			};
			trigger.addEventListener('click', () => (list.hidden ? open() : close()));
			trigger.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowDown') {
					e.preventDefault();
					open(true);
				}
			});
			list.addEventListener('keydown', (e) => {
				const all = links();
				const i = all.indexOf(document.activeElement as HTMLAnchorElement);
				if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
					e.preventDefault();
					all[(i + (e.key === 'ArrowDown' ? 1 : -1) + all.length) % all.length].focus();
				}
			});
			this.addEventListener('focusout', (e) => {
				if (!this.contains(e.relatedTarget as Node)) close();
			});
			this.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') close(true);
			});
			document.addEventListener('pointerdown', (e) => {
				if (!this.contains(e.target as Node)) close();
			});
		}
	}
	customElements.define('nav-menu', NavMenu);
</script>

<style>
	.nav-menu {
		position: relative;
		display: block;
	}
	.nav-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.125rem;
		padding: 0.3125rem 0.375rem 0.3125rem 0.625rem;
		border: 0;
		border-radius: 0.625rem;
		background: none;
		color: var(--muted);
		font: inherit;
		font-size: 0.875rem;
		cursor: pointer;
		transition:
			color 0.15s,
			background-color 0.15s;
	}
	.nav-trigger:hover,
	.nav-trigger[aria-expanded='true'] {
		background-color: var(--surface);
		color: var(--text);
	}
	.nav-trigger:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 1px;
	}
	.icon-trigger {
		justify-content: center;
		width: 2.125rem;
		height: 2.125rem;
		padding: 0;
		background-color: var(--surface);
		color: var(--text);
	}
	.icon-trigger:hover,
	.icon-trigger[aria-expanded='true'] {
		background-color: var(--surface-2);
	}
	[data-icon] .nav-list {
		right: 0;
		left: auto;
		min-width: 13rem;
		transform-origin: top right;
	}
	.caret {
		transition: transform 0.2s var(--ease);
	}
	[aria-expanded='true'] .caret {
		transform: rotate(180deg);
	}

	.nav-list {
		position: absolute;
		top: calc(100% + 0.375rem);
		left: 0;
		z-index: 60;
		display: grid;
		min-width: 17rem;
		margin: 0;
		padding: 0.25rem;
		border: 1px solid var(--border);
		border-radius: 0.75rem;
		background-color: var(--bg);
		box-shadow:
			0 1px 2px rgb(0 0 0 / 0.06),
			0 12px 32px -8px rgb(0 0 0 / 0.2);
		list-style: none;
		transform-origin: top left;
		animation: nav-in 0.18s var(--ease);
	}
	.nav-list[hidden] {
		display: none;
	}
	@keyframes nav-in {
		from {
			opacity: 0;
			transform: scale(0.96) translateY(-4px);
		}
	}
	.nav-list a {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		padding: 0.4375rem 0.5rem;
		border-radius: 0.5rem;
		color: var(--text);
		font-size: 0.8125rem;
		line-height: 1.3;
		text-decoration: none;
		outline: none;
	}
	.nav-list a:is(:hover, :focus-visible) {
		background-color: var(--surface-2);
	}
	.nav-icon {
		display: grid;
		flex: none;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 0.5rem;
		background-color: var(--surface);
		color: var(--text);
	}
	.nav-icon img {
		width: 1.125rem;
		height: 1.125rem;
	}
	.nav-icon.avatar {
		overflow: hidden;
		border-radius: 50%;
	}
	.nav-icon.avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.nav-text {
		display: grid;
		flex: 1;
		gap: 0.0625rem;
	}
	.nav-note {
		color: var(--muted);
		font-size: 0.75rem;
	}
	.external {
		color: var(--faint);
	}
	@media (prefers-reduced-motion: reduce) {
		.nav-list {
			animation: none;
		}
	}
</style>
