---
// On phones, where the docs' sidebar has no room, the current page's title
// at the left of the bar above the content, opening a card of the docs'
// pages to move to another.
import { Icon } from '@astrojs/starlight/components';

type Entry = (typeof Astro.locals.starlightRoute.sidebar)[number];
interface Row {
	label: string;
	depth: number;
	href?: string;
	current?: boolean;
}
const { sidebar, entry } = Astro.locals.starlightRoute;
const rows: Row[] = [];
const walk = (entries: Entry[], depth: number) => {
	for (const e of entries) {
		if (e.type === 'link') rows.push({ label: e.label, href: e.href, current: e.isCurrent, depth });
		else {
			rows.push({ label: e.label, depth });
			walk(e.entries, depth + 1);
		}
	}
};
walk(sidebar, 0);
const title = rows.find((r) => r.current)?.label ?? entry.data.title;
---

<doc-picker class="doc-picker">
	<details>
		<summary>
			<span class="doc-title">{title}</span>
			<Icon name="down-caret" size="1rem" class="caret" />
		</summary>
		<nav class="doc-list" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
			{
				rows.map((r) =>
					r.href ? (
						<a href={r.href} aria-current={r.current ? 'page' : undefined} style={`--depth: ${Math.max(0, r.depth - 1)}`}>
							{r.label}
						</a>
					) : (
						<p class="doc-group">{r.label}</p>
					),
				)
			}
		</nav>
	</details>
</doc-picker>

<script>
	class DocPicker extends HTMLElement {
		connectedCallback() {
			const details = this.querySelector('details')!;
			const close = () => (details.open = false);
			document.addEventListener('click', (e) => {
				if (!details.contains(e.target as Node)) close();
			});
			this.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && details.open) {
					close();
					details.querySelector('summary')?.focus();
				}
			});
			details.addEventListener('toggle', () => {
				if (details.open) details.querySelector<HTMLElement>('[aria-current="page"]')?.scrollIntoView({ block: 'nearest' });
			});
		}
	}
	customElements.define('doc-picker', DocPicker);
</script>

<style>
	.doc-picker {
		display: block;
		position: relative;
		min-width: 0;
	}
	/* Wider screens show the sidebar beside the content instead. */
	@media (min-width: 50rem) {
		.doc-picker {
			display: none;
		}
	}
	summary {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		min-width: 0;
		padding: 0.375rem 0.5rem 0.375rem 0;
		color: var(--text);
		font-size: 0.875rem;
		font-weight: 600;
		list-style: none;
		cursor: pointer;
		user-select: none;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 1px;
		border-radius: 0.5rem;
	}
	.doc-title {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.caret {
		flex: none;
		color: var(--muted);
		transition: transform 0.2s var(--ease);
	}
	details[open] .caret {
		transform: rotate(180deg);
	}

	.doc-list {
		position: absolute;
		top: calc(100% + 0.625rem);
		left: 0;
		z-index: 60;
		display: grid;
		width: max-content;
		min-width: 12rem;
		max-width: min(18rem, calc(100vw - 2.5rem));
		max-height: min(65vh, 28rem);
		overflow-y: auto;
		padding: 0.25rem;
		border: 1px solid var(--border);
		border-radius: 0.75rem;
		background-color: var(--bg);
		box-shadow:
			0 1px 2px rgb(0 0 0 / 0.06),
			0 12px 32px -8px rgb(0 0 0 / 0.2);
		overscroll-behavior: contain;
		transform-origin: top left;
		animation: doc-in 0.18s var(--ease);
	}
	@keyframes doc-in {
		from {
			opacity: 0;
			transform: scale(0.96) translateY(-4px);
		}
	}
	.doc-group {
		margin: 0.5rem 0 0.125rem;
		padding: 0 0.625rem;
		color: var(--faint);
		font-size: 0.75rem;
		font-weight: 650;
	}
	.doc-group:first-child {
		margin-top: 0.25rem;
	}
	.doc-list a {
		padding: 0.4375rem 0.625rem;
		padding-inline-start: calc(0.625rem + var(--depth) * 0.75rem);
		border-radius: 0.5rem;
		color: var(--muted);
		font-size: 0.8125rem;
		line-height: 1.35;
		text-decoration: none;
		outline: none;
	}
	.doc-list a:is(:hover, :focus-visible) {
		background-color: var(--surface-2);
		color: var(--text);
	}
	.doc-list a[aria-current='page'] {
		color: var(--accent);
		font-weight: 550;
	}
	@media (prefers-reduced-motion: reduce) {
		.doc-list {
			animation: none;
		}
	}
</style>
