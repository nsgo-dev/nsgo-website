---
// One tier of sponsors, under its title, laid out as the tier says, with an
// invitation to its empty places after them. The sponsors page shows every
// tier, the home page those marked for it.
import '../../styles/sponsors.css';
import type { Lang } from '../../config';
import type { ResolvedSponsor, ResolvedTier } from '../../resolve';
import { site } from '../../site';
import KIcon from '../KIcon.astro';
import SectionHead from '../home/SectionHead.astro';
import SponsorImage from './SponsorImage.astro';

interface Props {
	lang: Lang;
	tier: ResolvedTier;
	/** The words under the title; none without. */
	text?: string;
}
const { lang, tier, text } = Astro.props;
const s = site[lang];
if (!s.sponsors) throw new Error('nsgo-website: SponsorTier needs the sponsors setting');
const t = s.t.sponsors;
const ext = { target: '_blank', rel: 'noopener noreferrer' };
const linkOf = (sponsor: ResolvedSponsor) => (sponsor.href ? { href: sponsor.href, ...ext } : {});
const tagOf = (sponsor: ResolvedSponsor) => (sponsor.href ? 'a' : 'div');
// The maintainers' cards are on the site; any other address leaves it.
const invite = { href: s.sponsors.invite, ...(s.sponsors.maintainers.length ? {} : ext), 'data-kubai-trigger': '' };
const { layout, sponsors, left } = tier;
const lists = { featured: 'featured-wall', large: 'logo-wall large', small: 'logo-wall small', service: 'service-wall', avatar: 'avatar-wall', name: 'name-wall' };
const heights = { featured: 48, large: 40, small: 24, service: 32, avatar: 56, name: 0 };
---

<section class="section sponsors-section">
	<div class="container">
		<SectionHead title={tier.title} text={text} />
		<ul class={lists[layout]}>
			{
				sponsors.map((sponsor) => {
					const Tag = tagOf(sponsor);
					const image = sponsor.image && <SponsorImage sponsor={sponsor} height={heights[layout]} decorative={layout === 'avatar'} />;
					const name = <span class="logo-name">{sponsor.name}</span>;
					switch (layout) {
						case 'featured':
							return (
								<li>
									<Tag class="featured-sponsor" {...linkOf(sponsor)}>
										<span class="featured-logo">{image || name}</span>
										{sponsor.text && <span class="featured-text">{sponsor.text}</span>}
									</Tag>
								</li>
							);
						case 'large':
						case 'small':
							return (
								<li>
									<Tag class="logo-tile" title={sponsor.name} {...linkOf(sponsor)}>
										{image || name}
									</Tag>
								</li>
							);
						case 'service':
							return (
								<li>
									<Tag class="service-tile" {...linkOf(sponsor)}>
										<span class="service-logo">{image || name}</span>
										{sponsor.text && <span class="service-text">{sponsor.text}</span>}
									</Tag>
								</li>
							);
						case 'avatar':
							return (
								<li>
									<Tag class="avatar-tile" {...linkOf(sponsor)}>
										<span class="avatar">{image || sponsor.name.slice(0, 1)}</span>
										<span class="avatar-name">{sponsor.name}</span>
									</Tag>
								</li>
							);
						case 'name':
							return <li>{sponsor.href ? <a {...linkOf(sponsor)}>{sponsor.name}</a> : sponsor.name}</li>;
					}
				})
			}
			{
				left > 0 && (
					<li class="invite">
						{layout === 'featured' ? (
							<a class="featured-sponsor invite-card" {...invite}>
								<KIcon name="heart" size={28} color="#ec4899" />
								<span class="invite-label">{t.become}</span>
								<span class="invite-left">{t.left(left)}</span>
							</a>
						) : layout === 'avatar' ? (
							<a class="avatar-tile" {...invite} title={t.left(left)}>
								<span class="avatar invite-card">
									<KIcon name="heart" size={22} color="#ec4899" />
								</span>
								<span class="avatar-name">{t.become}</span>
							</a>
						) : (
							<a class:list={['invite-card', { 'logo-tile': layout === 'large' || layout === 'small', 'service-tile': layout === 'service', 'name-invite': layout === 'name' }]} {...invite} title={t.left(left)}>
								<KIcon name="heart" size={layout === 'name' ? 14 : 18} color="#ec4899" />
								<span class="invite-label">{t.become}</span>
								{layout !== 'name' && layout !== 'small' && <span class="invite-left">{t.left(left)}</span>}
							</a>
						)}
					</li>
				)
			}
		</ul>
	</div>
</section>
