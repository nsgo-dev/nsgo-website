---
// A numbered list of effects, as a demo's parts: the section's head over
// the Effect components in its slot, three to a row on wide screens unless
// columns says otherwise.
import '../../styles/home.css';
import '../../styles/effects.css';
import SectionHead from '../home/SectionHead.astro';

interface Props {
	id?: string;
	eyebrow?: string;
	title?: string;
	text?: string;
	columns?: number;
}
const { id, eyebrow, title, text, columns } = Astro.props;
---

<section class="section" id={id}>
	<div class="container">
		{title && <SectionHead eyebrow={eyebrow} title={title} text={text} />}
		<ol class="effects" style={columns ? `--columns: ${columns}` : undefined}>
			<slot />
		</ol>
	</div>
</section>
