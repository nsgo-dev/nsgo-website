---
// Content that drifts at its own speed as the page scrolls, for depth:
// speed is the share of the scroll it moves by, below 0 against it. It
// holds still for readers who ask for less motion.
interface Props {
	speed?: number;
	class?: string;
}
const { speed = 0.15, class: className } = Astro.props;
---

<div class:list={['parallax', className]}><div data-parallax={speed}><slot /></div></div>

<script>
	import { startParallax } from '../../scripts/demos';
	startParallax();
</script>
