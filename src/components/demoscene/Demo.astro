---
// A demoscene effect drawn in real time, in the site's accent, dithered a
// pixel at a time: knot, plasma, tunnel, rotozoom, bounce, scope, trail,
// terrain or stars. width and height are its pixels, before it is scaled
// up to its box. With drag the reader turns it by dragging (the knot);
// the trail follows the pointer inside the closest [data-demo-steer].
import type { DemoName } from '../../scripts/demos';

interface Props {
	effect: DemoName;
	width?: number;
	height?: number;
	/** Whether the reader turns it by dragging it. */
	drag?: boolean;
	class?: string;
}
const { effect, width = 96, height = 96, drag = false, class: className } = Astro.props;
---

<canvas class:list={['demo', className]} data-demo={effect} data-drag={drag ? '' : undefined} width={width} height={height} aria-hidden="true"></canvas>

<style>
	.demo {
		display: block;
		image-rendering: pixelated;
	}
	/* Dragged sideways it turns; up and down, the page still scrolls on touch. */
	.demo[data-drag] {
		cursor: grab;
		touch-action: pan-y;
	}
	.demo[data-drag]:active {
		cursor: grabbing;
	}
</style>

<script>
	import { startDemos } from '../../scripts/demos';
	startDemos();
</script>
