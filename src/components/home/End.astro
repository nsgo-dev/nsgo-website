---
// The closing card: a logo, a title, a few words and buttons over a faint
// field of characters.
import '../../styles/home.css';
import { images } from 'virtual:nsgo-website/assets';
import type { Lang } from '../../config';
import type { ResolvedAction } from '../../resolve';
import nsgoLogo from '../../assets/nsgo.svg?url';
import AsciiField from '../AsciiField.astro';
import ActionButton from './ActionButton.astro';

interface Props {
	lang: Lang;
	id?: string;
	eyebrow?: string;
	title: string;
	text?: string;
	/** An image file the settings name, or 'nsgo' for NSGo's logo; none without. */
	logo?: string;
	actions?: ResolvedAction[];
}
const { lang, id, eyebrow, title, text, logo, actions = [] } = Astro.props;
const src = logo === 'nsgo' ? nsgoLogo : logo ? images[logo]?.src : undefined;
const phrases = title.split(/(?<=[，、])/);
---

<section class="section end" id={id}>
	<div class="container">
		<div class="end-card">
			<AsciiField />
			{src && <img class="end-logo" src={src} alt="" width="64" height="64" />}
			{eyebrow && <p class="eyebrow">{eyebrow}</p>}
			<h2>{phrases.map((p) => <span class="phrase">{p}</span>)}</h2>
			{text && <p>{text}</p>}
			{
				actions.length > 0 && (
					<div class="cta center">
						{actions.map((action, index) => (
							<ActionButton lang={lang} action={action} index={index} />
						))}
					</div>
				)
			}
		</div>
	</div>
</section>
