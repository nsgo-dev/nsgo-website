---
// The home page's opening: the status, the headline, the lead, the buttons
// and the chips on one side, and the project's own picture, in the visual
// slot, on the other.
import '../../styles/home.css';
import type { Lang } from '../../config';
import type { ResolvedAction } from '../../resolve';
import ActionButton from './ActionButton.astro';

interface Props {
	lang: Lang;
	status?: string;
	headline: [string, string];
	lead: string;
	actions?: ResolvedAction[];
	chips?: string[];
}
const { lang, status, headline, lead, actions = [], chips = [] } = Astro.props;
const visual = Astro.slots.has('visual');
---

<section class="hero">
	<div class:list={['container', 'hero-row', { single: !visual }]}>
		<div class="hero-copy">
			{
				status && (
					<p class="status-pill rise" style="--i: 0">
						<span class="dot" aria-hidden="true" />
						{status}
					</p>
				)
			}
			<h1 id="_top" class="headline rise" style="--i: 0">
				<span>{headline[0]}</span>
				<span class="accent">{headline[1]}</span>
			</h1>
			<p class="lead rise" style="--i: 1">{lead}</p>
			{
				actions.length > 0 && (
					<div class="cta rise" style="--i: 2">
						{actions.map((action, index) => (
							<ActionButton lang={lang} action={action} index={index} />
						))}
					</div>
				)
			}
			{
				chips.length > 0 && (
					<ul class="hero-meta rise" style="--i: 3">
						{chips.map((m) => (
							<li>{m}</li>
						))}
					</ul>
				)
			}
		</div>
		{
			visual && (
				<div class="hero-stage rise" style="--i: 1">
					<slot name="visual" />
				</div>
			)
		}
	</div>
</section>
