---
// The content beside its table of contents, which narrower screens show as
// a bar above the content instead. On phones a docs page without one still
// has the bar, for its title to move to another page.
import DocPicker from '../shell/DocPicker.astro';

const { toc, hasSidebar } = Astro.locals.starlightRoute;
---

<div class:list={['two-column', { 'has-toc': toc }]}>
	{
		toc ? (
			<aside class="toc print:hidden">
				<slot name="right-sidebar" />
			</aside>
		) : (
			hasSidebar && (
				<aside class="toc toc-bare print:hidden">
					<div class="docs-bar">
						<DocPicker />
					</div>
				</aside>
			)
		)
	}
	<div class="main-pane">
		<slot />
	</div>
</div>
