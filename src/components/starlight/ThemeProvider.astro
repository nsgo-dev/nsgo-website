---
// Starlight's theme from the reader's choice, or always dark for a look
// made for the dark only, whatever the reader chose elsewhere.
import Default from '@astrojs/starlight/components/ThemeProvider.astro';
import { first, site } from '../../site';
---

{
	site[first].darkOnly ? (
		<script is:inline>
			document.documentElement.dataset.theme = 'dark';
			document.documentElement.dataset.darkOnly = '';
		</script>
	) : (
		<Default />
	)
}
