---
// The bar above a docs page's content on narrower screens: on phones the
// page's title, to move to another page, and the table of contents.
import Default from '@astrojs/starlight/components/MobileTableOfContents.astro';
import DocPicker from '../shell/DocPicker.astro';
---

<div class="docs-bar">
	{Astro.locals.starlightRoute.hasSidebar && <DocPicker />}
	<Default />
</div>
