---
// Every page's frame: the shared header and footer around the page's own
// content. A docs page puts its sidebar, content and table of contents in
// the header's container, so moving between pages only replaces what is
// between the header and the footer.
import MenuPane from '../shell/MenuPane.astro';
import SiteFooter from '../shell/SiteFooter.astro';

const { hasSidebar, entry } = Astro.locals.starlightRoute;
const isHome = Boolean((entry.data as { home?: boolean }).home);
---

<div class:list={['shell', { 'is-home': isHome, 'is-docs': hasSidebar }]}>
	<header class="site-header"><slot name="header" /></header>
	{
		hasSidebar ? (
			<div class="container docs-frame">
				<MenuPane docked>
					<slot name="sidebar" slot="sidebar" />
				</MenuPane>
				<div class="main-frame">
					<slot />
				</div>
			</div>
		) : (
			<>
				<MenuPane docked={false} />
				<div class="main-frame">
					<slot />
				</div>
			</>
		)
	}
	<SiteFooter />
</div>
