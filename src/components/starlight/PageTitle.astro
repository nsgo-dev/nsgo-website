---
// The title, with the page's description under it as its lead.
import Default from '@astrojs/starlight/components/PageTitle.astro';

const { description, home } = Astro.locals.starlightRoute.entry.data as { description?: string; home?: boolean };
---

{
	!home && (
		<>
			<Default />
			{description && <p class="lead">{description}</p>}
		</>
	)
}

<style>
	.lead {
		margin-top: 0.75rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-lg);
		line-height: 1.6;
	}
</style>
