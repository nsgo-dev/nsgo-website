---
// A page of the site's own layout, outside the docs: the shared header and
// footer around whatever it holds, as the home and roadmap pages. A project
// makes its own pages with it in src/pages/, and under src/pages/<code>/ for
// each other language.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import type { Lang } from '../config';
import { site } from '../site';

interface Props {
	lang: Lang;
	title: string;
	description?: string;
	/** Whether the site's search lists the page; defaults to false. */
	search?: boolean;
}
const { lang, title, description, search = false } = Astro.props;
---

<StarlightPage
	frontmatter={{ title, description, template: 'splash', home: true, tableOfContents: false, pagefind: search }}
	hasSidebar={false}
	lang={site[lang].locale.tag}
>
	<slot />
</StarlightPage>
