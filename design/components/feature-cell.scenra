component name="Home/Feature" width=fill preview=378 backdrop="bg-[#e6e8ec]"
box name=cell class="flex-1 gap-1.5 bg-[#ffffff] px-6 py-7" note="Lighter on hover."
  icon file-text name=icon class="mb-4 size-7 text-[#3b82f6]"
  text "Plain text" name=title class="text-base font-semibold text-[#0b0d12]"
  text "Every note is a Markdown file you can open in any editor." name=text class="text-[15px] leading-relaxed text-[#5b6270]"
end
variant row icon.class="mb-0" class="gap-3"
