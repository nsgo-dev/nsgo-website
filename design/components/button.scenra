component name="Controls/Button"
box name=button class="h-11 flex-row items-center justify-center gap-2 rounded-xl border border-transparent bg-[#007aff] px-[18px] shadow-lg shadow-[#007aff]/35"
  svg "<svg viewBox='0 0 16 16'><path fill='#0b0d12' d='M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38v-1.49c-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.5 7.5 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8z'/></svg>" name=lead class="hidden size-[17px]"
  text "Get started" name=label class="text-[15px] font-semibold text-[#ffffff]"
  icon arrow-right name=trail class="size-4 text-[#ffffff]"
end
variant secondary button.class="border-[#e6e8ec] bg-white shadow-sm shadow-[#101828]/10" label.class="text-[#0b0d12]" trail="external-link" trail.class="size-3.5 text-[#0b0d12]/60"
variant github variant=secondary label="GitHub" lead.class="flex"
variant large button.class="h-13 px-[22px]" label.class="text-base"
