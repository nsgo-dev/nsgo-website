design name="Pages/Home" device=desktop height=4000 class="bg-[#ffffff]"
box class="flex-1"
  use site-header brand.tap="open home" features.tap="open home" docs.tap="open docs" roadmap.tap="open roadmap" sponsors.tap="open sponsors" search.tap="open search" features.state=selected
  box class="h-[700px] flex-row items-center gap-[72px] px-8 pb-16 pt-12" note="The hero, from home: status, headline, lead, actions and chips; the visual is the project's own component. Each part rises into place in turn."
    box class="flex-1 items-start"
      box class="mb-6 flex-row items-center gap-2 rounded-full border border-[#e6e8ec] bg-[#f6f7f9] py-1 pl-2.5 pr-3"
        box class="size-2 rounded-full bg-[#f59e0b] ring-[3px] ring-[#f59e0b]/20"
        end
        text "Sample project · not a real app" class="text-[13px] font-medium text-[#5b6270]"
      end
      text "Notes that stay" class="text-[64px] font-bold leading-[1.05] tracking-tighter text-[#0b0d12]"
      svg "<svg viewBox='0 0 520 74'><defs><linearGradient id='h' x1='0' x2='1'><stop offset='0.1' stop-color='#007aff'/><stop offset='0.9' stop-color='#8b5cf6'/></linearGradient></defs><text x='0' y='56' font-family='-apple-system, Helvetica, Arial, sans-serif' font-size='64' font-weight='700' letter-spacing='-2.2' fill='url(#h)'>out of your way.</text></svg>" class="mb-5 h-[74px] w-[520px]" note="The headline's second line, in the accent's gradient."
      text "Sample Notes keeps plain-text notes on your device, finds them as you type and syncs them through a folder you choose. It is made up, to fill this example." class="max-w-[544px] text-[19px] leading-relaxed text-[#5b6270]"
      box class="mb-6 mt-9 flex-row gap-3"
        use button variant=large button.tap="open docs" note="Actions default to Get started, to the docs, and GitHub."
        use button variant="github large"
      end
      box class="flex-row gap-2"
        text "macOS" class="rounded-full border border-[#e6e8ec] px-3 py-1 text-[13px] text-[#5b6270]"
        text "Windows" class="rounded-full border border-[#e6e8ec] px-3 py-1 text-[13px] text-[#5b6270]"
        text "Linux" class="rounded-full border border-[#e6e8ec] px-3 py-1 text-[13px] text-[#5b6270]"
        text "iOS" class="rounded-full border border-[#e6e8ec] px-3 py-1 text-[13px] text-[#5b6270]"
      end
    end
    box class="flex-1 overflow-hidden rounded-[20px] border border-[#e6e8ec] bg-[#f6f7f9] shadow-2xl shadow-[#101828]/20" note="The example's own visual, NotesMock.tsx, drawn in CSS."
      box class="flex-row gap-1.5 border-b border-[#e6e8ec] px-3 py-2.5"
        box class="size-2.5 rounded-full bg-[#d4d7dd]"
        end
        box class="size-2.5 rounded-full bg-[#d4d7dd]"
        end
        box class="size-2.5 rounded-full bg-[#d4d7dd]"
        end
      end
      box class="h-[300px] flex-row"
        box class="w-2/5 gap-1 border-r border-[#e6e8ec] p-3"
          text "Trip to the coast" class="rounded-lg bg-[#4da3ff] px-2.5 py-1.5 text-[13px] font-semibold text-white"
          text "Reading list" class="px-2.5 py-1.5 text-[13px] text-[#5b6270]"
          text "Groceries" class="px-2.5 py-1.5 text-[13px] text-[#5b6270]"
        end
        box class="flex-1 gap-3 px-5 py-4"
          text "Trip to the coast" class="text-[17px] font-semibold text-[#0b0d12]"
          box class="flex-row items-center gap-2.5 opacity-55"
            box class="size-3.5 items-center justify-center rounded border-[1.5px] border-[#4da3ff] bg-[#4da3ff]"
            end
            text "Leave on Friday morning" class="text-sm text-[#0b0d12] line-through"
          end
          box class="flex-row items-center gap-2.5"
            box class="size-3.5 rounded border-[1.5px] border-[#d4d7dd]"
            end
            text "Book a room near the harbour" class="text-sm text-[#0b0d12]"
          end
          box class="flex-row items-center gap-2.5"
            box class="size-3.5 rounded border-[1.5px] border-[#d4d7dd]"
            end
            text "Pack the camera" class="text-sm text-[#0b0d12]"
          end
        end
      end
    end
  end
  box class="gap-12 px-8 py-24" note="A features section: three to a row on wide screens, two on tablets, one on phones."
    use section-head
    box class="gap-px overflow-hidden rounded-[20px] border border-[#e6e8ec] bg-[#e6e8ec]"
      box class="flex-row gap-px"
        use feature-cell class="flex-1"
        use feature-cell class="flex-1" icon=search icon.class="text-[#8b5cf6]" title="Instant search" text="Notes are found by title and text as you type."
        use feature-cell class="flex-1" icon=list-checks icon.class="text-[#22a45d]" title="Checklists" text="Tick items off without leaving the keyboard."
      end
      box class="flex-row gap-px"
        use feature-cell class="flex-1" icon=folder-sync icon.class="text-[#f59e0b]" title="Folder sync" text="Point it at any synced folder to see the same notes everywhere."
        use feature-cell class="flex-1" icon=moon icon.class="text-[#0ea5e9]" title="Light and dark" text="Follows the system’s appearance or keeps your own."
        use feature-cell class="flex-1" icon=languages icon.class="text-[#ec4899]" title="Many languages" text="The interface speaks the languages of the system."
      end
    end
  end
  box class="flex-row items-center gap-[72px] px-8 py-24" note="A split section: words and points beside code highlighted at build, or the project's own component."
    box class="w-[480px] gap-8"
      use section-head variant=left eyebrow="Usage" title="A few lines of Go" text="Sample Notes is an NSGo app: its views are written in Go and drawn natively on every platform." text.class="flex"
      box class="gap-5"
        box class="flex-row gap-3.5"
          box class="size-10 items-center justify-center rounded-xl border border-[#e6e8ec] bg-[#f6f7f9]"
            icon code class="size-[22px] text-[#6366f1]"
          end
          box class="flex-1 gap-1"
            text "State as signals" class="text-base font-semibold text-[#0b0d12]"
            text "The open note and the search are signals the views read." class="text-[15px] text-[#5b6270]"
          end
        end
        box class="flex-row gap-3.5"
          box class="size-10 items-center justify-center rounded-xl border border-[#e6e8ec] bg-[#f6f7f9]"
            icon rocket class="size-[22px] text-[#14b8a6]"
          end
          box class="flex-1 gap-1"
            text "Hot reload" class="text-base font-semibold text-[#0b0d12]"
            text "Changes to a view show while the app runs." class="text-[15px] text-[#5b6270]"
          end
        end
        box class="flex-row gap-3.5"
          box class="size-10 items-center justify-center rounded-xl border border-[#e6e8ec] bg-[#f6f7f9]"
            icon puzzle class="size-[22px] text-[#d97706]"
          end
          box class="flex-1 gap-1"
            text "One codebase" class="text-base font-semibold text-[#0b0d12]"
            text "The same code builds the app for every platform." class="text-[15px] text-[#5b6270]"
          end
        end
      end
    end
    box class="flex-1 gap-1 rounded-[10px] border border-[#e6e8ec] bg-[#f6f7f9] p-5 shadow-xl shadow-[#101828]/15"
      text "func Root(cx *core.Scope) core.Node {" class="font-mono text-sm text-[#0b0d12]"
      text "    notes := store.Open(cx, \"~/Notes\")" class="font-mono text-sm text-[#0b0d12]"
      text "    return core.View{Children: []core.Node{" class="font-mono text-sm text-[#0b0d12]"
      text "        notes.List{}," class="font-mono text-sm text-[#0060d1]"
      text "        ui.Button{Text: \"New note\", OnPress: notes.New}," class="font-mono text-sm text-[#0060d1]"
      text "    }}" class="font-mono text-sm text-[#0b0d12]"
      text "}" class="font-mono text-sm text-[#0b0d12]"
    end
  end
  box class="gap-12 px-8 py-24" note="A cards section: four to a row, each icon above its title."
    use section-head eyebrow="Platforms" title="Four platforms, one app"
    box class="flex-row gap-px overflow-hidden rounded-[20px] border border-[#e6e8ec] bg-[#e6e8ec]"
      use feature-cell class="flex-1" icon=laptop icon.class="mb-0 size-[30px] text-[#3b82f6]" title="macOS" text="Apple silicon and Intel." cell.class="gap-3"
      use feature-cell class="flex-1" icon=app-window icon.class="mb-0 size-[30px] text-[#0ea5e9]" title="Windows" text="x64 and arm64." cell.class="gap-3"
      use feature-cell class="flex-1" icon=terminal icon.class="mb-0 size-[30px] text-[#d97706]" title="Linux" text="x64 with Wayland or X11." cell.class="gap-3"
      use feature-cell class="flex-1" icon=smartphone icon.class="mb-0 size-[30px] text-[#8b5cf6]" title="iOS" text="iPhone and iPad." cell.class="gap-3"
    end
  end
  box class="gap-9 px-8 py-24" note="The sponsors' tiers marked home, before the closing card."
    use section-head eyebrow.class="hidden" title="Gold sponsors" text="NSGO is kept going by these sponsors." text.class="flex"
    box class="flex-row gap-5"
      box class="h-48 flex-1 items-center justify-center gap-2 rounded-[20px] border border-[#e6e8ec] bg-[#f6f7f9] px-6 py-7"
        svg "<svg viewBox='0 0 192 48'><path d='M8 38a16 16 0 0 1 32 0' fill='none' stroke='#2563eb' stroke-width='7' stroke-linecap='round'/><circle cx='24' cy='16' r='5' fill='#2563eb'/><text x='54' y='32.5' font-family='-apple-system, Helvetica, Arial, sans-serif' font-size='25' font-weight='700' fill='#0b0d12'>Northwind</text></svg>" class="mb-2 h-12 w-48"
        text "Cloud folders for teams" class="text-center text-[15px] text-[#5b6270]"
      end
      box class="h-48 flex-1 items-center justify-center gap-2 rounded-[20px] border border-[#e6e8ec] bg-[#f6f7f9] px-6 py-7"
        svg "<svg viewBox='0 0 192 48'><circle cx='24' cy='24' r='14' fill='#f59e0b'/><circle cx='24' cy='24' r='6' fill='#f6f7f9'/><text x='50' y='32.5' font-family='-apple-system, Helvetica, Arial, sans-serif' font-size='25' font-weight='700' fill='#0b0d12'>Lumen Labs</text></svg>" class="mb-2 h-12 w-48"
        text "Fonts for small screens" class="text-center text-[15px] text-[#5b6270]"
      end
      box class="h-48 flex-1 items-center justify-center gap-1.5 rounded-[20px] border border-dashed border-[#d4d7dd] px-6 py-7" tap="open sponsors" note="An invitation to the tier's open places; warms to pink on hover."
        icon heart class="size-7 fill-[#ec4899] text-[#ec4899]"
        text "Become a sponsor" class="mt-2 text-[15px] font-semibold text-[#5b6270]"
        text "8 places left" class="text-[13px] text-[#8a909b]"
      end
    end
  end
  box class="px-8 pb-20 pt-12"
    box class="items-center overflow-hidden rounded-[28px] border border-[#e6e8ec] bg-linear-to-b from-[#007aff]/15 to-[#f6f7f9] to-60% px-6 py-[104px]" note="The closing card, over a faint field of characters that drifts behind it."
      svg "<svg viewBox='-16.51 -2.63 129.26 129.26'><defs><linearGradient id='g' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#007aff'/><stop offset='1' stop-color='#007aff'/></linearGradient></defs><g transform='skewX(-10)'><rect x='12.5' y='40.5' width='26' height='11' rx='5.5' fill='#2a8fff'/><rect x='2.5' y='56.5' width='36' height='11' rx='5.5' fill='#2a8fff'/><rect x='16.5' y='72.5' width='22' height='11' rx='5.5' fill='#2a8fff'/></g><g transform='skewX(-10)'><path d='M68 23H88A25 25 0 0 1 113 48V76A25 25 0 0 1 88 101H68A25 25 0 0 1 43 76V48A25 25 0 0 1 68 23ZM68 37A11 11 0 0 0 57 48V76A11 11 0 0 0 68 87H88A11 11 0 0 0 99 76V48A11 11 0 0 0 88 37Z' fill='url(#g)'/></g></svg>" class="mb-5 size-16"
      text "Built for NSGo" class="text-[40px] font-bold tracking-tight text-[#0b0d12]"
      text "NSGo is a cross-platform native UI engine with a Go backend." class="mb-8 mt-4 max-w-[512px] text-center text-base text-[#5b6270]"
      box class="flex-row gap-3"
        use button label="NSGo website" trail="external-link" trail.class="size-3.5"
        use button variant=github
      end
    end
  end
  use site-footer
end
